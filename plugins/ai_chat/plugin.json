{
  "name": "ai_chat",
  "display_name": "AI 对话",
  "version": "1.0.0",
  "author": "MacroSTAR",
  "description": "接入 OpenAI 兼容接口的群聊 AI 助手，支持命令、@ 唤醒、名字唤醒与人格设定",
  "config": [
    {
      "key": "enabled",
      "label": "启用 AI 对话",
      "type": "bool",
      "default": false,
      "hint": "关闭后完全不走 AI 逻辑"
    },
    {
      "key": "api_base",
      "label": "API 地址（OpenAI 兼容）",
      "type": "string",
      "default": "https://api.deepseek.com",
      "placeholder": "https://api.deepseek.com",
      "hint": "不要带 /v1/chat/completions 路径"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "secret",
      "default": "",
      "placeholder": "sk-..."
    },
    {
      "key": "model",
      "label": "模型",
      "type": "string",
      "default": "deepseek-chat",
      "placeholder": "deepseek-chat"
    },
    {
      "key": "temperature",
      "label": "Temperature",
      "type": "number",
      "default": 1.0,
      "min": 0,
      "max": 2,
      "step": 0.1,
      "hint": "越大越发散；闲聊 1.0~1.3，需要稳定输出时 0.3~0.7"
    },
    {
      "key": "max_tokens",
      "label": "Max Tokens",
      "type": "int",
      "default": 2048,
      "min": 64,
      "max": 8192,
      "step": 64
    },
    {
      "key": "max_history",
      "label": "历史消息轮数",
      "type": "int",
      "default": 10,
      "min": 0,
      "max": 50,
      "hint": "越大越贵，上下文也越长"
    },
    {
      "key": "direct_chat",
      "label": "私聊直连 / @ 唤醒",
      "type": "bool",
      "default": false,
      "hint": "开启后，私聊任意消息、群里 @ 机器人都会触发对话"
    },
    {
      "key": "allow_groups",
      "label": "群白名单",
      "type": "int_list",
      "default": [],
      "hint": "留空 = 不限制。填了则只有列表内的群能用"
    },
    {
      "key": "allow_users",
      "label": "用户白名单",
      "type": "int_list",
      "default": [],
      "hint": "留空 = 不限制"
    },
    {
      "key": "system_prompt",
      "label": "系统提示词",
      "type": "text",
      "rows": 3,
      "default": "你是 Lunar X 的 AI 助手，请用中文简洁友好地回答问题。",
      "hint": "人格提示词为空时的兜底"
    },
    {
      "key": "persona.enabled",
      "label": "启用名字唤醒",
      "type": "bool",
      "default": true,
      "hint": "群聊中消息以唤醒词开头才触发"
    },
    {
      "key": "persona.nicknames",
      "label": "唤醒词",
      "type": "string_list",
      "default": ["小月", "月月"],
      "hint": "每行一个；按长度降序匹配，短词不会吃掉长词"
    },
    {
      "key": "persona.system_prompt",
      "label": "人格设定",
      "type": "text",
      "rows": 5,
      "default": "",
      "hint": "优先级高于上面的系统提示词"
    }
  ]
}
