// ============================================================================
// Lunar X 主配置参考（config.json）
//
// 【重要】运行时读取的是项目根目录下的 config.json，它必须是**严格 JSON**
// （不能带注释）。原因：WebUI 保存配置时用 json.dump() 全量覆写 config.json，
// 任何注释都会被抹掉。本文件只是带注释的说明副本，程序不会读取它。
//
// 用法：
//   cp config.example.json config.json   # 项目根目录有一份可直接用的严格 JSON
//   然后在 WebUI「配置」页里改，或直接手改本文件后删掉注释再改名
//
// ⚠️ config.json 含 token 等凭据，已被 .gitignore 排除，**不要提交进仓库**。
// ============================================================================
{
  // ── 协议端连接 ────────────────────────────────────────────────────────────
  // 使用的协议实现："milky"（推荐，配合 LLBot/LLOneBot）或 "onebot"
  // ⚠️ 协议 / 地址 / token 改动**需要重启 Bot 才生效**（热更新不覆盖这几项）
  "protocol": "milky",

  // Milky 协议端 HTTP 地址（protocol = "milky" 时生效）
  // LLBot 默认 3010 端口，注意结尾不要加 /
  "milky_server": "http://127.0.0.1:3010",

  // Milky 协议端的访问令牌，需与协议端设置里的 token 一致；协议端未设则留空 ""
  // ⚠️ Milky 与 OneBot 是两套独立凭据，不会互相回退
  "milky_token": "",

  // OneBot 正向 WebSocket 地址（protocol = "onebot" 时生效）
  "ws_server": "ws://127.0.0.1:3803",

  // OneBot access_token，需与 appsettings.json 中 Implementations[].AccessToken 一致
  // 留空表示不鉴权；不要使用 114514 这类公开默认值
  "token": "",

  // ── 机器人身份 ────────────────────────────────────────────────────────────
  // 超级管理员 QQ 号（整数）。0 表示不设置，改为在 WebUI「用户」页添加 super_users
  // ⚠️ 改这个约 1 秒内热生效，撤销管理员不需要重启
  "root_user": 0,

  // 机器人显示名 / 英文名（帮助信息、部分插件输出里会用到）
  "bot_name": "Lunar X",
  "bot_name_en": "Lunar",

  // ── 命令与运行行为 ────────────────────────────────────────────────────────
  // 命令触发前缀。例如设为 "$" 时，命令写作 $帮助；设为 "/" 则是 /帮助
  // ⚠️ 改这个会影响所有插件的命令，改完建议重启主进程
  "trigger_keyword": "$",

  // 插件热重载：为 true 时修改 plugins/ 下的文件会自动重新加载，无需重启
  // 生产环境可设为 false 以减少文件监听开销
  "auto_reload_plugins": true,

  // 日志级别："DEBUG" | "INFO" | "WARNING" | "ERROR"
  // 排查问题时用 DEBUG，日常用 INFO
  "log_level": "INFO",

  // 【保存到文件】的日志级别，可多选。控制台输出仍由上面的 log_level 决定。
  // 每次运行会单独归档一份日志到 logs/runs/，最近一次运行的日志始终实时写入
  // logs/lunarx.log（WebUI 控制台读取的就是它）。
  // 可选值：DEBUG / INFO / SUCCESS / WARNING / ERROR / CRITICAL
  // 删除该字段或留空数组 = 全部级别都保存
  "log_save_levels": ["DEBUG", "INFO", "SUCCESS", "WARNING", "ERROR", "CRITICAL"]
}

// ============================================================================
// 管理员名单不在这里
//
// super_users / manager_users 存在 admin114.json（与 config.json 同目录），
// 由 WebUI「用户」页维护，改完约 1 秒内热生效。
//
// AI 对话配置也不在这里
//
// AI 的 API 地址 / Key / 模型 / 人格等在 **插件私有配置**：
//   plugins/ai_chat/config.json
// 字段清单见 plugins/ai_chat/plugin.json，界面在 WebUI「插件管理 → ai_chat → 配置」。
// 插件升级不会覆盖你的 config.json。
// ============================================================================
