// ============================================================================
// WebUI 控制面板配置参考（webui.json）
//
// 运行时文件为 webui.json，必须是严格 JSON。首次启动 webui.py 会自动生成，
// 缺失的字段也会自动补齐，正常情况下不需要手改。
// ============================================================================
{
  // ── 插件安装源 ────────────────────────────────────────────────────────────
  // 装插件时是否走 PyPI 镜像（国内服务器建议 true）
  "use_pypi_mirror": true,

  // PyPI 镜像地址，use_pypi_mirror 为 true 时生效
  "pypi_mirror": "https://pypi.tuna.tsinghua.edu.cn/simple",

  // GitHub 加速前缀，留空 "" 表示直连。形如 "https://ghproxy.example.com/"
  "github_mirror": "",

  // 【机密】GitHub Personal Access Token，仅在拉取私有插件仓库时需要，
  // 一般留空。分发前务必清空。
  "github_pat": "",

  // 插件索引仓库（owner/repo），面板「可用插件」列表从这里拉取
  "plugins_index_repo": "MacroSTAR-Org/Unisphere",

  // ── 登录凭据 ──────────────────────────────────────────────────────────────
  // 面板登录用户名，默认 lunarx
  "username": "lunarx",

  // 【机密】密码哈希（pbkdf2$salt$hash），**不要手填明文**。
  // 改密码请用面板里的「修改密码」，会自动重新计算哈希。
  "password_hash": "",

  // 【机密】会话签名密钥，首次启动随机生成。
  // 改动或清空会使所有已登录会话立即失效（相当于强制全部重新登录）。
  "session_secret": ""
}
