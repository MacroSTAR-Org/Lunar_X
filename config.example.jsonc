// ============================================================================
// Lunar X 主配置参考（config.json）
//
// 【重要】运行时读取的是同目录下的 config.json，它必须是**严格 JSON**（不能带注释）。
//   原因：WebUI 保存配置时用 json.dump() 全量覆写 config.json，任何注释都会被抹掉。
//   本文件只是带注释的说明副本，程序不会读取它。
//
// 用法：复制本文件为 config.json，然后**删掉所有 // 注释行**，或直接用 WebUI 面板改。
// ============================================================================
{
  // ── 协议端连接 ────────────────────────────────────────────────────────────
  // 使用的协议实现："milky"（推荐，配合 LLBot/LLOneBot）或 "onebot"
  "protocol": "milky",

  // Milky 协议端 HTTP 地址（protocol = "milky" 时生效）
  // LLBot 默认 3010 端口，注意结尾不要加 /
  "milky_server": "http://127.0.0.1:3010",

  // Milky 协议端的访问令牌，需与协议端设置里的 token 一致；协议端未设则留空 ""
  "milky_token": "",

  // OneBot 正向 WebSocket 地址（protocol = "onebot" 时生效）
  "ws_server": "ws://127.0.0.1:3803",

  // OneBot access_token，需与 appsettings.json 中 Implementations[].AccessToken 一致
  "token": "114514",

  // ── 机器人身份 ────────────────────────────────────────────────────────────
  // 机器人自己的 QQ 号（整数，不要加引号）。用于识别自身消息、@ 判定等
  "bot_qq": 123456789,

  // 超级管理员 QQ 号（整数）。拥有全部命令权限，务必改成你自己的号
  "root_user": 1348472639,

  // 机器人显示名 / 英文名（帮助信息、部分插件输出里会用到）
  "bot_name": "Lunar X",
  "bot_name_en": "Lunar X",

  // ── 命令与运行行为 ────────────────────────────────────────────────────────
  // 命令触发前缀。例如设为 "$" 时，命令写作 $帮助；设为 "/" 则是 /帮助
  // 注意：改这个会影响所有插件的命令，改完建议重启主进程
  "trigger_keyword": "$",

  // 插件热重载：为 true 时修改 plugins/ 下的文件会自动重新加载，无需重启
  // 生产环境可设为 false 以减少文件监听开销
  "auto_reload_plugins": true,

  // 日志级别："DEBUG" | "INFO" | "WARNING" | "ERROR"
  // 排查问题时用 DEBUG，日常用 INFO
  "log_level": "INFO",

  // 【保存到文件】的日志级别，可多选。控制台输出仍由上面的 log_level 决定。
  // 每次运行会单独归档一份日志到 logs/runs/，最近一次运行的日志始终实时写入
  // logs/lunarx.log（WebUI 控制台读取的就是它）。
  // 可选值：DEBUG / INFO / SUCCESS / WARNING / ERROR / CRITICAL
  // 删除该字段或留空数组 = 全部级别都保存
  "log_save_levels": ["DEBUG", "INFO", "SUCCESS", "WARNING", "ERROR", "CRITICAL"],

  // 内置「答案」插件的候选数字，随机回一个。可自由增删
  "answer": [114, 3803, 114514],

  // ── AI 对话（plugins/ai_chat.py 读取此块）────────────────────────────────
  "ai": {
    // 总开关：false 时完全不走 AI 逻辑
    "enabled": true,

    // OpenAI 兼容接口的基址（不含 /v1/chat/completions 路径）
    // DeepSeek: https://api.deepseek.com  |  OpenAI: https://api.openai.com/v1
    "api_base": "https://api.deepseek.com",

    // 【机密】接口密钥。分发/提交 git 前务必清空成 ""
    "api_key": "",

    // 模型名，需与上面的 api_base 匹配
    "model": "deepseek-chat",

    // 采样温度。0~2，越大越发散；日常闲聊 1.0~1.3，需要稳定输出时 0.3~0.7
    "temperature": 1.2,

    // 单次回复的最大 token 数
    "max_tokens": 2048,

    // 每个会话保留的历史轮数（越大越贵、上下文越长）
    "max_history": 10,

    // 是否允许「不 @ 机器人、不带唤醒词」直接聊天
    // true 会让机器人回应群里的普通发言，慎开
    "direct_chat": false,

    // 白名单。**留空数组 = 不限制**（全部群 / 全部用户可用）
    // 填了内容则只有列表内的群号 / QQ 号可以触发 AI
    "allow_groups": [],
    "allow_users": [],

    // 全局系统提示词（人设为空时的兜底）
    "system_prompt": "你是 Lunar X 的 AI 助手，请用中文简洁友好地回答问题。",

    // 人设：唤醒词 + 角色提示词，可在 WebUI「人设」页里改
    "persona": {
      // 唤醒词。消息里出现其中任意一个即视为在叫机器人
      "nicknames": ["小月", "月月"],

      // 角色提示词，优先级高于上面的 system_prompt
      "system_prompt": "你是小月，一个温柔可爱的 AI 助手。你说话亲切、简短，偶尔带一点点俏皮。"
    }
  },

  // ── 其它模型密钥（按需填写，均为【机密】，提交前清空）────────────────────
  // 默认使用的模型标识，供部分插件切换用
  "default_mode": "Ds",
  "deepseek_key": "",
  "gemini_key": "",
  "openai_key": ""
}
