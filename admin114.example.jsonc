// ============================================================================
// 权限名单参考（admin114.json）
//
// 运行时文件为 admin114.json，必须是严格 JSON。
// 也可以在 WebUI 的「用户管理」页里直接改，改完立即生效。
// 注意：QQ 号写整数，不要加引号。
// ============================================================================
{
  // 超级用户：可执行重载、重启、插件开关等高危命令
  // config.json 里的 root_user 天然拥有全部权限，无需重复写在这里
  "super_users": [2473768771],

  // 管理员：可执行日常管理命令（如群管相关），权限低于 super_users
  "manager_users": []
}
