# ============================================================================
# 环境变量示例：复制到 /etc/lunarx.env 并按需修改
#
#   sudo cp deploy/lunarx.env.example /etc/lunarx.env
#   sudo chmod 600 /etc/lunarx.env
#   sudo systemctl daemon-reload && sudo systemctl restart lunarx-webui
#
# ⚠️ 这个文件可能包含敏感信息，务必 chmod 600，且不要提交进仓库。
# ============================================================================

# ── 协议端凭据（从 WebUI「配置」页读取，这里只作留档）────────────────────
# MILKY_SERVER=http://127.0.0.1:3010
# MILKY_TOKEN=
# ONEBOT_WS_SERVER=ws://127.0.0.1:3803
# ONEBOT_TOKEN=

# ── WebUI 监听 ───────────────────────────────────────────────────────────
# 只监听本机，公网访问走 Nginx / Caddy
LUNARX_WEB_HOST=127.0.0.1
LUNARX_WEB_PORT=5000
# Gunicorn 用的 bind（wsgi.py 走这个变量）
LUNARX_WEB_BIND=127.0.0.1:5000
# worker 数量，默认按 CPU 核数
# LUNARX_WEB_WORKERS=4
# LUNARX_WEB_THREADS=4

# ── 反向代理 ─────────────────────────────────────────────────────────────
# 前端有几层反代（通常 1）。**不要在没有反代时设置**，
# 否则用户可以伪造 X-Forwarded-For 绕过 IP 白名单。
LUNARX_TRUST_PROXY=1

# 外层是 https 时必须为 1，否则 session cookie 不带 Secure 标记
LUNARX_COOKIE_SECURE=1

# 允许的 Host 头，逗号分隔，防 Host 注入
LUNARX_ALLOWED_HOSTS=lunarx.example.com

# ── 其它 ─────────────────────────────────────────────────────────────────
# LUNARX_WEB_LOGLEVEL=info
# 忘记改密码时的应急重置（会备份损坏的 webui.json 并重建凭据）
# LUNARX_WEBUI_RESET=1
